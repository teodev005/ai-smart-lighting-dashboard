# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# MQTT Broker Configuration
MQTT_BROKER=mqtt://broker.emqx.io:1883
MQTT_WSS_BROKER=wss://broker.emqx.io:8084/mqtt

# Persistence & Storage
DATABASE_PATH=./data/devices.json

# Timeouts & Watchdogs (in milliseconds)
TELEMETRY_TIMEOUT_MS=10000
PAIRING_TIMEOUT_MS=15000
